# Copy to .env.cameraman in the project you are recording. Never commit it.

# What gets recorded. A scenario's forbidHosts refuses localhost for review videos.
RECORD_BASE_URL=https://example.com

# Chrome is started by hand with --remote-debugging-port; see the skill.
RECORD_CDP_URL=http://127.0.0.1:9222
# Empty = take devicePixelRatio from the browser. Override on HiDPI if clicks miss.
# RECORD_POINTER_SCALE=1
RECORD_POINTER_MOVE_MS=700

# Pin a specific ffmpeg/ffprobe. Unset = PATH, then the bundled fallback.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Preflight fetches the current bundled ffmpeg once where only the old one is
# present. Set to 1 to keep preflight off the network.
# CAMERAMAN_SKIP_FFMPEG_DOWNLOAD=1

# OBS, only for --backend obs.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=

# Narration. Voice ids come from the account, never from memory.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# Where project scenarios live (default: ./cameraman-scenarios).
# CAMERAMAN_SCENARIOS=./cameraman-scenarios
